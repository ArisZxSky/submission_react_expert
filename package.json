{
  "name": "ruangkata-forum",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Aplikasi forum diskusi React dengan automation testing dan Storybook untuk submission Dicoding.",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.2.0",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "happy-dom": "20.11.0",
    "storybook": "^10.4.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "vite build",
    "preview": "vite preview",
    "check:core": "npm run lint && npm test && npm run build",
    "check": "npm run check:core && npm run build-storybook",
    "ci": "npm run lint && npm test && npm run build && npm run build-storybook",
    "check:all": "npm run check && npm run e2e"
  }
}
